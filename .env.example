# ============================================================
# MEDISPHERE COGNITIVE TWIN - ENVIRONMENT CONFIGURATION
# ============================================================
# Copy to .env and edit. The .env file is gitignored; this
# template is safe to commit and contains NO real secrets.
#
#   cp .env.example .env
#
# Every variable below is actually read by the application.
# ------------------------------------------------------------
# PRODUCTION REQUIREMENTS
# ------------------------------------------------------------
# With SPRING_PROFILES_ACTIVE=prod, the following have NO
# defaults and the backend REFUSES TO START without them:
#
#   MONGODB_URI   full MongoDB connection string
#   JWT_SECRET    HMAC signing key, >= 32 bytes
#                 generate: openssl rand -base64 48
#
# Values in this file are DEVELOPMENT DEFAULTS ONLY.
# ============================================================

# ------------------------------------------------------------
# Database Storage (MongoDB)
# ------------------------------------------------------------
# Development: local MongoDB, e.g. the `mongodb` service from
# docker-compose, or your own local instance.
MONGODB_URI=mongodb://localhost:27017/medisphere
MONGODB_DATABASE=medisphere
MONGODB_ENABLED=false

# Production example (Atlas):
#   MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/medisphere

# ------------------------------------------------------------
# Apache Kafka Event Streaming
# ------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=medisphere-group
KAFKA_ENABLED=false

# ------------------------------------------------------------
# FHIR Interoperability & SMART on FHIR
# ------------------------------------------------------------
# Only these are read by the application. FhirService currently
# serves mocked resources; it makes no outbound HTTP request.
FHIR_CLIENT_ID=medisphere-client
FHIR_AUTHORIZE_URL=http://localhost:8081/oauth/authorize
FHIR_TOKEN_URL=http://localhost:8081/oauth/token

# ------------------------------------------------------------
# Clinical Authentication & Security
# ------------------------------------------------------------
# Development placeholder. NEVER reuse this outside local dev.
# Minimum 32 bytes required for HS256 signing.
JWT_SECRET=dev-only-insecure-jwt-signing-key-not-valid-anywhere-else
JWT_EXPIRATION_MS=86400000

# Demo mode serves synthetic data and relaxes clinical checks.
# Must be false in production.
DEMO_MODE=true

# ------------------------------------------------------------
# Docker Compose (only used by docker-compose.yml)
# ------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me-local-dev-only
